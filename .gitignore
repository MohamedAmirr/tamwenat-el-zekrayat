# secrets / local config
.env

# python
__pycache__/
*.pyc
.venv/

# node
node_modules/

# frappe bench artifacts inside apps/<app_name>/ (bind-mounted into the dev
# bench container — see docs/dev-environment.md). The bench itself (frappe,
# erpnext, env, node_modules, sites) lives in a docker volume, never on host.
apps/*/env/
apps/*/node_modules/
apps/*/.git/
# node_modules can also appear as a symlink inside an app's public/ dir (e.g.
# apps/marketplace_integrations/marketplace_integrations/public/node_modules)
# - the slash-suffixed patterns above only match a real directory, not a
# symlink, so this slashless entry is needed to actually ignore it.
node_modules
logs/
sites/*
!sites/.gitkeep

# os / editor
.DS_Store
*.swp
